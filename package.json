{
  "name": "quarkus-graphql-quickstart",
  "version": "1.2.1-SNAPSHOT",
  "description": "GraphQL Quickstart + MinIO as Object Store S3. It's much more than just a Quickstart",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "author": {
    "name": "Antonio Musarra",
    "email": "antonio.musarra@gmail.com",
    "url": "https://www.dontesta.it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amusarra/quarkus-graphql-quickstart.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/multipart": "^9.2.1",
    "fastify": "^5.6.1",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "minio": "^8.0.6",
    "pg": "^8.23.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
